<% content_for :page_header do %>
  <div class="space-y-1 mb-6 flex gap-4 justify-between items-center lg:items-start">
    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary">Reports</h1>
      <p class="text-sm lg:text-base text-secondary">Understand your cash flow at a glance</p>
    </div>
  </div>
<% end %>

<% currency    = @income_totals.currency
   income_val  = @income_totals.total.to_f
   expense_val = @expense_totals.total.to_f %>

<div class="w-full space-y-6 pb-24">
  <%= turbo_frame_tag "reports_cashflow_section" do %>
    <div class="space-y-6">
      <%# --- Period selector --- %>
      <div class="flex justify-end items-center gap-4">
        <%= form_with url: reports_path, method: :get, data: { controller: "auto-submit-form", turbo_frame: "reports_cashflow_section" } do |form| %>
          <%= form.select :cashflow_period,
                    Period.as_options,
                    { selected: @cashflow_period.key },
                    data: { "auto-submit-form-target": "auto" },
                    class: "bg-container border border-secondary font-medium rounded-lg px-3 py-2 text-sm pr-7 cursor-pointer text-primary focus:outline-hidden focus:ring-0" %>
        <% end %>
      </div>

      <%# --- Summary tiles (Monarch-style) --- %>
      <%= render "pages/cashflow_summary_tiles",
            income_totals: @income_totals,
            expense_totals: @expense_totals,
            prior_income_total: @prior_income_total,
            prior_expense_total: @prior_expense_total,
            comparison_label: @comparison_label %>

      <%# --- Sub-tabs: Cash Flow / Spending / Income --- %>
      <%= render DS::Tabs.new(active_tab: @reports_tab, session_key: "reports_tab") do |tabs| %>
        <% tabs.with_nav(classes: "max-w-md") do |nav| %>
          <% nav.with_btn(id: "cashflow", label: "Cash Flow") %>
          <% nav.with_btn(id: "spending", label: "Spending") %>
          <% nav.with_btn(id: "income", label: "Income") %>
        <% end %>

        <%# Cash Flow: interactive Sankey + drill-down transactions %>
        <% tabs.with_panel(tab_id: "cashflow") do %>
          <div class="space-y-6">
            <%= render "pages/cashflow_sankey", sankey_data: @cashflow_sankey_data, interactive: true, period_key: @cashflow_period.key %>
            <%= turbo_frame_tag "reports_transactions" %>
          </div>
        <% end %>

        <%# Spending: expense donut + category breakdown %>
        <% tabs.with_panel(tab_id: "spending") do %>
          <%= render "pages/category_donut",
                title: "Spending",
                segments: @expense_donut_segments,
                total: expense_val,
                currency: currency,
                empty_text: "No spending for this time period" %>
        <% end %>

        <%# Income: income donut + category breakdown %>
        <% tabs.with_panel(tab_id: "income") do %>
          <%= render "pages/category_donut",
                title: "Income",
                segments: @income_donut_segments,
                total: income_val,
                currency: currency,
                empty_text: "No income for this time period" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

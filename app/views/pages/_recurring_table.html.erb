<%# locals: title, series, currency, testid %>
<section class="bg-container rounded-xl shadow-border-xs p-5 space-y-4" data-testid="<%= testid %>">
  <h2 class="font-medium text-lg text-primary"><%= title %></h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-secondary text-left border-b border-alpha-black-100 theme-dark:border-alpha-white-200">
          <th class="font-medium py-2 pr-4">Name</th>
          <th class="font-medium py-2 pr-4">Cadence</th>
          <th class="font-medium py-2 pr-4">Next date</th>
          <th class="font-medium py-2 pr-4 text-right">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% series.each do |item| %>
          <tr class="border-b border-alpha-black-50 theme-dark:border-alpha-white-100 last:border-0">
            <td class="py-2.5 pr-4">
              <p class="text-primary font-medium"><%= item.name %></p>
              <% if item.category_name.present? %>
                <p class="text-xs text-secondary"><%= item.category_name %></p>
              <% end %>
            </td>
            <td class="py-2.5 pr-4 text-secondary"><%= item.cadence %></td>
            <td class="py-2.5 pr-4 text-secondary"><%= item.next_date.strftime("%b %d, %Y") %></td>
            <td class="py-2.5 pr-4 text-right text-primary font-medium whitespace-nowrap"><%= item.amount_money.format %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

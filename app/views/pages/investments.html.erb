<% content_for :page_header do %>
  <div class="space-y-1 mb-6 flex gap-4 justify-between items-center lg:items-start">
    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary">Investments</h1>
      <p class="text-sm lg:text-base text-secondary">Your portfolio, allocation, and holdings</p>
    </div>
  </div>
<% end %>

<% currency = @investments_currency %>

<div class="w-full space-y-6 pb-24">
  <% if @investment_accounts.empty? %>
    <div class="bg-container rounded-xl shadow-border-xs p-8 flex flex-col items-center text-center space-y-3">
      <%= render DS::FilledIcon.new(variant: :container, icon: "trending-up") %>
      <p class="text-sm font-medium text-primary">No investment accounts yet</p>
      <p class="text-secondary text-sm">Add an investment or crypto account to track holdings, allocation, and performance.</p>
      <%= render DS::Link.new(text: "Add account", icon: "plus", href: new_account_path, frame: :modal) %>
    </div>
  <% else %>
    <%# --- Summary tiles --- %>
    <div class="grid grid-cols-2 md:grid-cols-4 bg-container rounded-xl shadow-border-xs md:divide-x divide-y md:divide-y-0 divide-alpha-black-100 theme-dark:divide-alpha-white-200">
      <div class="p-4 space-y-2">
        <p class="text-sm text-secondary">Total value</p>
        <p class="text-primary font-medium text-xl"><%= Money.new(@total_value, currency).format %></p>
      </div>
      <div class="p-4 space-y-2">
        <p class="text-sm text-secondary">Holdings</p>
        <p class="text-primary font-medium text-xl"><%= Money.new(@holdings_total, currency).format %></p>
      </div>
      <div class="p-4 space-y-2">
        <p class="text-sm text-secondary">Cash</p>
        <p class="text-primary font-medium text-xl"><%= Money.new(@cash_total, currency).format %></p>
      </div>
      <div class="p-4 space-y-2">
        <p class="text-sm text-secondary">Total return</p>
        <% return_pct = @total_cost_basis.zero? ? 0 : (@total_return / @total_cost_basis * 100).round(1) %>
        <p class="<%= @total_return.round(2).negative? ? "text-destructive" : "text-success" %> font-medium text-xl">
          <%= Money.new(@total_return, currency).format %>
        </p>
        <p class="text-xs text-secondary"><%= number_to_percentage(return_pct, precision: 1) %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <%# --- Allocation donut --- %>
      <section class="bg-container rounded-xl shadow-border-xs p-5 space-y-4">
        <h2 class="font-medium text-lg text-primary">Allocation</h2>
        <% if @allocation_segments.present? %>
          <div class="relative h-56" data-testid="investments-allocation-chart">
            <%= tag.div data: { controller: "donut-chart", donut_chart_segments_value: @allocation_segments.to_json }, class: "relative h-full" do %>
              <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>
              <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
                <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
                  <span class="text-secondary text-sm mb-1">Portfolio</span>
                  <span class="text-2xl font-medium text-primary"><%= Money.new(@total_value, currency).format %></span>
                </div>
              </div>
            <% end %>
          </div>
          <div class="space-y-1.5">
            <% @allocation_segments.each do |seg| %>
              <div class="flex items-center justify-between text-sm">
                <span class="flex items-center gap-2 text-primary">
                  <span class="w-2.5 h-2.5 rounded-full inline-block" style="background-color: <%= seg[:color] %>"></span>
                  <%= seg[:id] %>
                </span>
                <span class="text-secondary"><%= Money.new(seg[:amount], currency).format %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-secondary text-sm">No holdings to display.</p>
        <% end %>
      </section>

      <%# --- Holdings table --- %>
      <section class="bg-container rounded-xl shadow-border-xs p-5 space-y-4 lg:col-span-2">
        <h2 class="font-medium text-lg text-primary">Holdings</h2>
        <% if @holdings_rows.present? %>
          <div class="bg-container-inset rounded-xl p-1" data-testid="investments-holdings-table">
            <div class="grid grid-cols-12 items-center uppercase text-xs font-medium text-secondary px-4 py-2">
              <p class="col-span-5">Name</p>
              <p class="col-span-2 justify-self-end">Weight</p>
              <p class="col-span-3 justify-self-end">Value</p>
              <p class="col-span-2 justify-self-end">Return</p>
            </div>
            <div class="bg-container rounded-lg shadow-border-xs divide-y divide-alpha-black-100 theme-dark:divide-alpha-white-200">
              <% @holdings_rows.each do |row| %>
                <% weight = @holdings_total.zero? ? 0 : (row[:value] / @holdings_total * 100).round(1) %>
                <div class="grid grid-cols-12 items-center px-4 py-3 text-sm">
                  <div class="col-span-5 min-w-0">
                    <p class="font-medium text-primary truncate"><%= row[:name] %></p>
                    <% if row[:ticker].present? %><p class="text-xs text-secondary"><%= row[:ticker] %></p><% end %>
                  </div>
                  <p class="col-span-2 justify-self-end text-secondary"><%= number_to_percentage(weight, precision: 1) %></p>
                  <p class="col-span-3 justify-self-end text-primary font-medium"><%= Money.new(row[:value], currency).format %></p>
                  <p class="col-span-2 justify-self-end <%= row[:return_amount].round(2).negative? ? "text-destructive" : "text-success" %>">
                    <%= Money.new(row[:return_amount], currency).format %>
                  </p>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <p class="text-secondary text-sm">No holdings yet. Add trades to an investment account to see them here.</p>
        <% end %>
      </section>
    </div>

    <%# --- Investment accounts --- %>
    <section class="bg-container rounded-xl shadow-border-xs p-5 space-y-3">
      <h2 class="font-medium text-lg text-primary">Accounts</h2>
      <div class="divide-y divide-alpha-black-100 theme-dark:divide-alpha-white-200">
        <% @investment_accounts.each do |account| %>
          <%= link_to account_path(account), class: "flex items-center justify-between py-3" do %>
            <span class="text-primary font-medium"><%= account.name %></span>
            <span class="text-secondary"><%= Money.new(account.balance, account.currency).format %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

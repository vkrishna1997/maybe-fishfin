<%# locals: (series:, currency:) %>
<section class="bg-container rounded-xl shadow-border-xs p-5 space-y-4" data-testid="recurring-review-card">
  <div class="flex items-center gap-2">
    <%= icon "triangle-alert", color: "warning" %>
    <div>
      <h2 class="font-medium text-lg text-primary">Flagged for review</h2>
      <p class="text-sm text-secondary">
        <%= pluralize(series.size, "recurring item") %> that changed, went missing, or need a category
      </p>
    </div>
  </div>

  <div class="divide-y divide-alpha-black-50 theme-dark:divide-alpha-white-100">
    <% series.each do |item| %>
      <div class="py-4 space-y-3">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <%= link_to item.name, transactions_path(item.review_filter_params),
                  class: "text-primary font-medium truncate hover:underline",
                  data: { turbo_frame: "_top" } %>
            <ul class="mt-1 space-y-1">
              <% item.review_reasons.each do |reason| %>
                <li class="text-xs text-secondary flex items-center gap-1.5">
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-warning shrink-0"></span>
                  <%= reason %>
                </li>
              <% end %>
            </ul>
          </div>
          <div class="text-right shrink-0">
            <p class="text-primary font-medium whitespace-nowrap"><%= item.last_amount_money.format %></p>
            <p class="text-xs text-secondary"><%= item.cadence %></p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <%= form_with url: transactions_bulk_update_path, scope: "bulk_update", method: :post,
                data: { controller: "auto-submit-form", turbo_frame: "_top" },
                class: "flex items-center gap-2" do |form| %>
            <% item.entry_ids.each do |entry_id| %>
              <%= form.hidden_field :entry_ids, multiple: true, value: entry_id %>
            <% end %>
            <%= icon "tag", size: "sm", color: "secondary" %>
            <%= form.collection_select :category_id,
                  Current.family.categories.alphabetically, :id, :name,
                  { selected: item.category_id, prompt: "Set a category" },
                  class: "min-w-[160px] bg-transparent rounded border border-secondary cursor-pointer text-primary text-xs py-1 px-2",
                  data: { auto_submit_form_target: "auto", autosubmit_trigger_event: "change" } %>
          <% end %>

          <%= link_to transactions_path(item.review_filter_params),
                class: "text-xs text-secondary hover:text-primary flex items-center gap-1",
                data: { turbo_frame: "_top" } do %>
            <%= icon "list", size: "sm" %>
            Review <%= pluralize(item.entry_ids.size, "transaction") %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>

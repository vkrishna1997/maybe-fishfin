<% series = monthly_cashflow
   currency = @income_totals.currency
   max_val = (series.flat_map { |m| [ m[:income], m[:expense] ] }.max || 0)
   max_val = 1 if max_val.zero? %>

<section class="bg-container p-4 lg:p-6 rounded-xl shadow-border-xs space-y-6">
  <div class="flex items-center justify-between gap-4">
    <h2 class="text-lg font-medium text-primary">Income vs. expenses</h2>
    <div class="flex items-center gap-4 text-xs text-secondary">
      <span class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-success inline-block"></span> Income
      </span>
      <span class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-destructive inline-block"></span> Expenses
      </span>
    </div>
  </div>

  <div class="flex items-end justify-between gap-3 h-56" data-testid="cashflow-over-time-chart">
    <% series.each do |m| %>
      <div class="flex-1 flex flex-col items-center gap-2 h-full justify-end">
        <div class="w-full flex items-end justify-center gap-1 h-full">
          <div class="w-1/2 max-w-8 bg-success/80 rounded-t-sm transition-all"
               style="height: <%= (m[:income] / max_val * 100).round(2) %>%"
               title="<%= m[:month] %> income: <%= Money.new(m[:income], currency).format %>">
          </div>
          <div class="w-1/2 max-w-8 bg-destructive/80 rounded-t-sm transition-all"
               style="height: <%= (m[:expense] / max_val * 100).round(2) %>%"
               title="<%= m[:month] %> expenses: <%= Money.new(m[:expense], currency).format %>">
          </div>
        </div>
        <p class="text-xs text-secondary"><%= m[:label] %></p>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 pt-2 border-t border-alpha-black-100 theme-dark:border-alpha-white-200">
    <% series.each do |m| %>
      <div class="text-center space-y-0.5 py-2">
        <p class="text-xs text-secondary"><%= m[:month] %></p>
        <p class="text-sm font-medium <%= m[:net].negative? ? "text-destructive" : "text-success" %>">
          <%= Money.new(m[:net], currency).format %>
        </p>
      </div>
    <% end %>
  </div>
</section>

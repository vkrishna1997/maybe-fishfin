<%# locals: (title:, category_totals:, total:, currency:) %>
<section class="bg-container p-4 rounded-xl shadow-border-xs space-y-4">
  <h3 class="text-sm font-medium text-secondary uppercase tracking-wide"><%= title %></h3>

  <% if category_totals.present? %>
    <div class="space-y-3">
      <% category_totals.each do |ct| %>
        <% share = total.to_d.zero? ? 0 : (ct.total.to_d / total.to_d * 100) %>
        <div class="space-y-1.5">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 min-w-0">
              <span class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full"
                    style="background-color: color-mix(in oklab, <%= ct.category.color %> 15%, transparent); color: <%= ct.category.color %>;">
                <%= icon ct.category.lucide_icon, size: "sm", color: "current" %>
              </span>
              <span class="text-sm font-medium text-primary truncate"><%= ct.category.name %></span>
            </div>
            <div class="shrink-0 flex items-center gap-2">
              <span class="text-sm font-medium text-primary tabular-nums"><%= Money.new(ct.total, currency).format %></span>
              <span class="text-xs text-secondary tabular-nums w-10 text-right"><%= number_to_percentage(share, precision: 0) %></span>
            </div>
          </div>
          <div class="w-full h-1.5 rounded-full bg-alpha-black-100 theme-dark:bg-alpha-white-200 overflow-hidden">
            <div class="h-full rounded-full" style="width: <%= [ share, 100 ].min %>%; background-color: <%= ct.category.color %>;"></div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-secondary py-4">No data for this time period</p>
  <% end %>
</section>

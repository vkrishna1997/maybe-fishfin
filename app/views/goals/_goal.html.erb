<%# locals: (goal:, monthly_savings: nil, savings_basis: :current, savings_months: 0) %>

<div id="<%= dom_id(goal) %>" class="bg-container rounded-xl shadow-border-xs p-5 space-y-4">
  <div class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2.5">
      <span class="w-3 h-3 rounded-full inline-block mt-1" style="background-color: <%= goal.color %>"></span>
      <div>
        <p class="text-primary font-medium"><%= goal.name %></p>
        <% if goal.target_date.present? %>
          <p class="text-xs text-secondary">Target <%= goal.target_date.strftime("%b %d, %Y") %></p>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <% if goal.completed? %>
        <span class="text-xs font-medium text-success bg-success/10 rounded-full px-2 py-0.5">Complete</span>
      <% elsif goal.target_date.present? %>
        <span data-controller="tooltip" data-tooltip-placement-value="top" class="cursor-help">
          <% if goal.on_track?(monthly_savings) %>
            <span class="text-xs font-medium text-success bg-success/10 rounded-full px-2 py-0.5">On track</span>
          <% else %>
            <span class="text-xs font-medium text-warning bg-warning/10 rounded-full px-2 py-0.5">Behind</span>
          <% end %>
          <span role="tooltip" data-tooltip-target="tooltip" class="tooltip bg-gray-700 text-sm p-2 rounded w-64 fg-inverse font-normal z-10">
            <% if savings_basis == :trailing %>
              Compares your average net savings over the last <%= pluralize(savings_months, "month") %> against the <%= goal.required_monthly_savings_money&.format %>/mo this goal needs.
            <% else %>
              Based on this month's net savings so far (limited history) vs the <%= goal.required_monthly_savings_money&.format %>/mo this goal needs.
            <% end %>
          </span>
        </span>
      <% end %>
      <%= render DS::Menu.new do |menu| %>
        <% menu.with_item(variant: "link", text: "Edit", href: edit_goal_path(goal), icon: "pencil", data: { turbo_frame: "modal" }) %>
        <% menu.with_item(
          variant: "button",
          text: "Delete",
          href: goal_path(goal),
          icon: "trash-2",
          method: :delete,
          confirm: CustomConfirm.for_resource_deletion(goal.name)
        ) %>
      <% end %>
    </div>
  </div>

  <div class="space-y-1.5">
    <div class="w-full h-2 rounded-full bg-alpha-black-100 theme-dark:bg-alpha-white-200 overflow-hidden">
      <div class="h-full rounded-full" style="width: <%= goal.progress_percent %>%; background-color: <%= goal.color %>"></div>
    </div>
    <div class="flex items-center justify-between text-sm">
      <span class="text-primary font-medium"><%= goal.current_amount_money.format %> <span class="text-secondary font-normal">of <%= goal.target_amount_money.format %></span></span>
      <span class="text-secondary"><%= number_to_percentage(goal.progress_percent, precision: 0) %></span>
    </div>
    <% unless goal.completed? %>
      <p class="text-xs text-secondary"><%= goal.remaining_money.format %> to go</p>
    <% end %>
  </div>

  <%# --- Monthly savings pace --- %>
  <% if !goal.completed? && goal.required_monthly_savings_money.present? %>
    <div class="pt-3 border-t border-alpha-black-100 theme-dark:border-alpha-white-200 flex items-center justify-between gap-2">
      <div>
        <p class="text-sm text-primary font-medium"><%= goal.required_monthly_savings_money.format %><span class="text-secondary font-normal">/mo needed</span></p>
        <% months = goal.months_remaining %>
        <p class="text-xs text-secondary">
          <% if months && months.positive? %>
            <%= pluralize(months, "month") %> to target
          <% else %>
            Target date reached
          <% end %>
        </p>
      </div>
      <% unless monthly_savings.nil? %>
        <div class="text-right">
          <% if goal.on_track?(monthly_savings) %>
            <p class="text-xs text-success font-medium">On pace</p>
          <% else %>
            <p class="text-xs text-warning font-medium">Behind pace</p>
          <% end %>
          <% if savings_basis == :trailing %>
            <p class="text-xs text-secondary"><%= Money.new(monthly_savings, goal.currency).format %>/mo avg · <%= savings_months %> mo</p>
          <% else %>
            <p class="text-xs text-secondary"><%= Money.new(monthly_savings, goal.currency).format %> this month</p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%# locals: (transaction: nil, entry_ids: nil, selected_category: nil) %>

<%
  badge_category = transaction ? transaction.category : selected_category
  dropdown_src = category_dropdown_path(
    category_id: badge_category&.id,
    transaction_id: transaction&.id,
    entry_ids: entry_ids
  )
%>

<%= render DS::Menu.new(variant: "button") do |menu| %>
  <% menu.with_button do %>
    <% render partial: "categories/badge", locals: { category: badge_category } %>
  <% end %>

  <% menu.with_custom_content do %>
    <%= turbo_frame_tag "category_dropdown", src: dropdown_src, loading: :lazy do %>
      <div class="p-6 flex items-center justify-center">
        <p class="text-sm text-secondary animate-pulse"><%= t(".loading") %></p>
      </div>
    <% end %>
  <% end %>
<% end %>
